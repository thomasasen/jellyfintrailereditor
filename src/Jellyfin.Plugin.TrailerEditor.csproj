<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetJellyfin Condition="'$(TargetJellyfin)' == ''">10.11</TargetJellyfin>
    <TargetFramework Condition="'$(TargetJellyfin)' == '10.11'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(TargetJellyfin)' == '12'">net10.0</TargetFramework>
    <JellyfinVersion Condition="'$(TargetJellyfin)' == '10.11'">10.11.11</JellyfinVersion>
    <JellyfinVersion Condition="'$(TargetJellyfin)' == '12'">12.0.0</JellyfinVersion>
    <AssemblyName>Jellyfin.Plugin.TrailerEditor</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.TrailerEditor</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <Target Name="ValidateJellyfinTarget" BeforeTargets="PrepareForBuild" Condition="'$(TargetJellyfin)' != '10.11' and '$(TargetJellyfin)' != '12'">
    <Error Text="TargetJellyfin must be 10.11 or 12" />
  </Target>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Common" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../web/trailer-editor.js" LogicalName="Jellyfin.Plugin.TrailerEditor.web.trailer-editor.js" />
  </ItemGroup>
</Project>
